# --- Overleaf projects -------------------------------------------------------
OVERLEAF_PROJECTS_CONFIG=/etc/overleaf-mcp/projects.json
# Single-project alternative:
# OVERLEAF_PROJECT_ID=64a1b2c3d4e5f6a7b8c9d0e1
# OVERLEAF_GIT_TOKEN_FILE=/etc/overleaf-mcp/token

# --- HTTP --------------------------------------------------------------------
PORT=18800
HOST=127.0.0.1
STATE_DIR=/var/lib/overleaf-mcp

# --- OAuth -------------------------------------------------------------------
PUBLIC_URL=https://overleaf.example.com
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=
ALLOWED_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
